{
  "hosting": [
    {
      "target": "admin",
      "public": "apps/dym_admin/build/web",
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        { "source": "**/*.@(js|wasm|png|webp|ttf|otf|json)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
        { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    },
    {
      "target": "client",
      "public": "apps/dym_client/build/web",
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ]
}
